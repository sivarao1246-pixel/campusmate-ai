# Google Identity Services
VITE_GOOGLE_CLIENT_ID=YOUR_CLIENT_ID.apps.googleusercontent.com

# Optional: enables the OpenAI-powered chat widget
VITE_OPENAI_API_KEY=your_openai_api_key_optional

# Optional: external news JSON endpoint
VITE_NEWS_ENDPOINT=your_news_endpoint_optional

# Optional display name
VITE_APP_NAME=CampusMate AI
